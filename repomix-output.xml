                                                                    <div className="font-bold text-[10px] mb-1 leading-tight">{item.itemName}</div>
                                                                </td>
                                                                <td className="border border-black p-1 align-top whitespace-pre-wrap text-[10px] leading-tight">
                                                                    <AutoResizeTextarea
                                                                        value={displayDescription}
