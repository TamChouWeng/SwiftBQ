                                            <div className="w-[40%]">
                                                <div className="mb-3">
                                                    <span className="font-bold text-xs uppercase border-b border-black pb-1 inline-block">QUOTE REFERENCE:</span>
                                                </div>
                                                <table className="w-full text-xs text-black border-collapse">
